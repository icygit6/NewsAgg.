<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="NewsAgg Backend" stopProcessing="true">
          <!-- API calls and authentication bypass the SPA container.
               The /bookmarks page itself must remain handled by React. -->
          <match url="^(api|auth)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="NewsAgg Client" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
