# Copy this file to server/.env. Never send the completed file over a public channel.
# Containers get their database URL from docker-compose.yml. NEONDB_URL here is
# for host-side scripts (daily run, backups) and local development, e.g.
# postgres://newsagg:<NEWSAGG_DB_PASSWORD>@127.0.0.1:5433/newsagg
NEONDB_URL=
SECRET_KEY=

# Optional integrations; they may stay empty for the first deployment.
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
GOOGLE_CLIENT_ID=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
FAVQS_API_KEY=
TWELVE_DATA_API_KEY=
COINGECKO_API_KEY=
SENTRY_DSN=

TRUST_PROXY=1
LOG_LEVEL=info

# Account email delivery. Use a newly generated Google App Password without
# spaces; never commit the completed file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NewsAgg <no-reply@example.com>
PUBLIC_CLIENT_URL=http://localhost:8080
CLIENT_URL=http://localhost:8080
