# Copy this file to .env in the package root.
# Same-origin works through the client Nginx, IIS, and public tunnels:
VITE_API_URL=
CLIENT_URL=http://localhost:8080,http://localhost
PUBLIC_CLIENT_URL=http://localhost:8080
TRUST_PROXY=1

# Permanent deployment: create a named Cloudflare Tunnel, route your public
# hostname to http://client:80, then set the token and HTTPS origin below.
# Example: PUBLIC_CLIENT_URL=https://news.example.com
CLOUDFLARE_TUNNEL_TOKEN=

# Browser-visible public identifiers (never put secret keys in VITE_* values).
VITE_GOOGLE_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=

# For a permanent public domain, set CLIENT_URL to that HTTPS origin.
# VITE_API_URL can remain empty because IIS proxies the API on the same origin.

GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK_MODEL=llama-3.3-70b-versatile
TWELVE_DATA_API_KEY=
