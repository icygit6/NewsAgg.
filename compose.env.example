# Copy this file to .env in the package root.
# Same-origin works through the client Nginx, IIS, and public tunnels:
VITE_API_URL=
CLIENT_URL=http://localhost:8080

# For a permanent public domain, set CLIENT_URL to that HTTPS origin.
# VITE_API_URL can remain empty because IIS proxies the API on the same origin.

GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK_MODEL=llama-3.3-70b-versatile
